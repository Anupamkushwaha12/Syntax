# FoodBridge Backend Environment Variables
# Copy this to .env and fill in your values

# App
APP_SECRET_KEY=your-super-secret-key-change-in-production
APP_ENV=development
FRONTEND_URL=http://localhost:5500

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/foodbridge
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/foodbridge

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Matching Engine
VOLUNTEER_RESPONSE_TIMEOUT_MINUTES=5
MAX_MATCHING_RADIUS_KM=20
AVG_SPEED_KMH=30
